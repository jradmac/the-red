class_name Enemies
extends Node
## Spawns the labyrinth's enemies and decides what each one does next.
##
##   Insects  roam in light and dark; chase you when you're close.
##            Spiders are fast. Moths are drawn to your lantern from afar.
##   Demons   hunt you, light or dark. Your lantern light weakens them in
##            battle (-1 DEF). In the dark you see only their eyes.
##   Ghosts   drift through walls and keep far from light. When your lantern
##            is out (and you're not standing by a candle or flare), they come
##            for you one after another: each strikes hard -- armor doesn't
##            help -- then vanishes, and another comes a few seconds later.
##            Strike a match to make them stop.
##
## Contact: insects and demons start a battle (battle.gd) -- one touching you,
## or you walking into one; either way the fight simply begins. Ghosts aren't
## fought; they just hit you.

signal hit_player(enemy: Enemy, damage: int)
signal encounter(enemy: Enemy)   ## an insect or demon lunged into you: fight!

## Insects and demons (names, stats, sprites) are generated by
## tools/make_creatures.py into CreatureData. Each design comes in a common
## colour and a tougher one (odd columns); the tough ones get likelier the
## deeper into the labyrinth you are.
const GHOST_TYPE := {"name": "GHOST", "atk": [9, 9], "def": [99, 99], "hp": 99, "step": 0.65, "aggro": 0}
## One enemy per this many map tiles (the big map: ~160 insects, ~70 demons, ~10 ghosts).
const TILES_PER := {"ghost": 2500}
const GHOSTS := 0   ## replaced by the Longman
const TILES_PER_CREATURE := 105          # insects + demons together, at average density
## Creatures thin out near the start and crowd the depths: the density at a
## spot `p` of the way down is DENSITY[0] + DENSITY[1] * p times the average
## (0.35x at the start, ~1.6x at the bottom). Overall a bit sparser than before.
const DENSITY := [0.35, 1.25]
const DENSITY_TOTAL := 0.85
const DEMON_SHARE := [0.12, 0.6]         # chance a creature is a demon: at the start .. at the end
## How creatures grow with depth. Tuned with a battle simulator (the real
## battle rules against a player who knows each nature, reads the tells and
## carries the gear the chests hand out by then -- see tools/battle_sim.py):
## a fight lasts ~3-4 rounds all the way down and costs about 3 hearts near
## the start, rising to ~8 at the bottom -- so every fight is worth avoiding
## or winning well, and the healing budget (Forage) is built on these numbers.
const SCALING := {
	"insect": {"atk": 1, "def": 3, "hp": 1.0, "hp_base": 1.6},
	"demon": {"atk": 2, "def": 2, "hp": 1.0, "hp_base": 1.2},
}
## Insects: only HUNTER_SHARE of them come after you; the rest keep their
## distance and only fight if you walk right up to them. Anything chasing you
## gives up if you open a gap (GIVE_UP_GAP tiles past where it noticed you)
## or it chases too long, and then leaves you be for CALM_TIME seconds.
const HUNTER_SHARE := 0.4
const SHY_REACH := 1.5
const SHY_AVOID := 4.0
const GIVE_UP_GAP := 2.5
const CHASE_PATIENCE := {"insect": 9.0, "demon": 16.0}
const CALM_TIME := [5.0, 9.0]


## How crowded a spot `p` of the way down is (1 = average).
static func density(p: float) -> float:
	return DENSITY[0] + DENSITY[1] * p
const ACTIVE_RANGE := 22         # enemies farther than this (tiles) sleep
const GHOST_HUNT_RANGE := 45     # ghosts this close come for you when your light dies
const MIN_SPAWN_DIST := 9        # tiles from the start
const GHOST_RUSH_STEP := 0.17    # seconds per tile when a ghost comes for you (fast)
const GHOST_APPEAR := 0.7        # seconds it takes to take shape before it comes
const GHOST_WINDUP := 0.35       # it rears up beside you this long before it strikes
const GHOST_DAMAGE := 3          # a ghost's hit in the dark (armor doesn't help)
const GHOST_RETURN := [16, 20]   # tiles away a wandering ghost is sent
const GHOST_REST := [2.5, 4.5]   # seconds it waits before coming again
const GHOST_KEEP_AWAY := 7.0     # tiles ghosts keep from you while you're lit
const STATIC_LIGHT_RADIUS := 2.0 # candles, mushrooms (tiles)
const FLARE_LIGHT_RADIUS := 3.0
const RECOIL_TIME := 2.5
const LIGHT_EDGE := 0.7   # tiles trimmed off the drawn light radius (its faint fringe)
const DIRS: Array[Vector2i] = [Vector2i.UP, Vector2i.DOWN, Vector2i.LEFT, Vector2i.RIGHT]

var world: World
var player: Player
var lantern: Lantern
var inventory: Inventory
var flares: Flares
var doors: Doors
var list: Array[Enemy] = []
var _static_lights: Array[Vector2i] = []
var _static_lit := PackedByteArray()   # 1 where candles / mushrooms light a tile
var _rng := RandomNumberGenerator.new()
var _think := {}   # enemy -> seconds until it decides again (when idle)
var _fx_parent: Node
var _hunter: Enemy   # the ghost coming for the bound player while they're in the dark
var _hunters := {}   # Hero -> the ghost hunting them
var cur: Hero        # the player the brains are currently thinking about
var _phase := {}     # hunter ghost -> "hidden" / "appear" / "rush" / "windup"
var day: DayCycle    # set by main: in daylight demons and ghosts are gone


func setup(w: World, p: Player, l: Lantern, inv: Inventory, f: Flares, dr: Doors,
		ground_parent: Node, ghost_parent: Node) -> void:
	world = w
	player = p
	lantern = l
	inventory = inv
	flares = f
	doors = dr
	_rng.seed = world.seed_value + 505
	_static_lights = world.cells_with("c") + world.cells_with("m")
	_static_lit.resize(world.width * world.height)
	_static_lit.fill(0)
	var r := int(ceil(STATIC_LIGHT_RADIUS))
	for s in _static_lights:
		for dy in range(-r, r + 1):
			for dx in range(-r, r + 1):
				var c: Vector2i = s + Vector2i(dx, dy)
				if Vector2(dx, dy).length() <= STATIC_LIGHT_RADIUS and world._in_bounds(c):
					_static_lit[c.y * world.width + c.x] = 1
	_fx_parent = ground_parent
	_spawn(ground_parent, ghost_parent)


func _spawn(ground_parent: Node, ghost_parent: Node) -> void:
	var start_sec: int = doors.section_of.get(world.start_cell, -1)
	var spots: Array[Vector2i] = []
	for y in world.height:
		for x in world.width:
			var c := Vector2i(x, y)
			if world.is_walkable(c) and (Vector2(c) - Vector2(world.start_cell)).length() >= MIN_SPAWN_DIST \
					and not world.near_village(c, 2):
				spots.append(c)
	var taken := {}
	var area := world.width * world.height
	# Ghosts: none any more -- the Longman (longman.gd) is what comes in the
	# dark now. (The ghost code below stays inert: GHOSTS = 0.)
	for n in GHOSTS:
		var c := _free_spot(spots, taken)
		var g := Enemy.new()
		g.setup("ghost", _rng.randi() % 5, GHOST_TYPE, c, _rng)
		ghost_parent.add_child(g)
		list.append(g)
		_think[g] = _rng.randf_range(0.0, 0.6)
	# Insects and demons: the deeper the spot, the likelier a demon, the
	# likelier the tougher colour of a creature, and the stronger it is.
	var want := int(area / TILES_PER_CREATURE * DENSITY_TOTAL)
	var placed := 0
	var tries := 0
	while placed < want and tries < want * 20:
		tries += 1
		var c := _free_spot(spots, taken)
		var p: float = doors.progress(c)
		if _rng.randf() * density(1.0) > density(p):
			taken.erase(c)
			continue   # quieter here: try somewhere else
		placed += 1
		var kind := "demon" if _rng.randf() < DEMON_SHARE[0] + (DEMON_SHARE[1] - DEMON_SHARE[0]) * p else "insect"
		if kind == "demon" and doors.section_of.get(c, -2) == start_sec:
			kind = "insect"   # the starting area is a breather
		var options: Array = CreatureData.TYPES[kind]
		var tough := _rng.randf() < 0.1 + 0.75 * p
		var v := (_rng.randi() % (options.size() / 2)) * 2 + (1 if tough else 0)
		var e := Enemy.new()
		e.setup(kind, v, options[v], c, _rng)
		e.hunter = kind == "demon" or _rng.randf() < HUNTER_SHARE
		_scale(e, p)
		ground_parent.add_child(e)
		list.append(e)
		_think[e] = _rng.randf_range(0.0, 0.6)


## Deeper creatures hit harder, guard better and take more beating.
	# a stable id for each creature, so a saved game knows who's who
	for k in list.size():
		list[k].set_meta("uid", k)


func _scale(e: Enemy, p: float) -> void:
	var s: Dictionary = SCALING[e.kind]
	e.atk += int(round(p * s.atk))
	e.def += int(round(p * s.def))
	e.hp = int(round(e.hp * (s.hp_base + p * s.hp)))
	e.max_hp = e.hp
	e.depth_progress = p


func _free_spot(spots: Array[Vector2i], taken: Dictionary) -> Vector2i:
	for attempt in 60:
		var c: Vector2i = spots[_rng.randi() % spots.size()]
		if not taken.has(c):
			taken[c] = true
			return c
	return spots[_rng.randi() % spots.size()]


# --- Queries -----------------------------------------------------------------

## Points this system at one player (see Hero.bind_all).
func bind(h: Hero) -> void:
	if cur != null:
		_hunters[cur] = _hunter
	cur = h
	player = h.player
	lantern = h.lantern
	inventory = h.inventory
	_hunter = _hunters.get(h, null)


func enemy_at(c: Vector2i) -> Enemy:
	var daytime := is_daytime()
	for e in list:
		if e.cell == c and e.kind != "ghost" and not (daytime and e.kind == "demon") and not e.in_battle:
			return e
	return null


func is_daytime() -> bool:
	return day != null and day.is_day()


## Is this tile inside any light right now (your lantern's glow, or near a
## candle, mushroom or flare)?
func is_lit(c: Vector2i) -> bool:
	for h in Hero.all:   # anyone's lantern
		if not h.alive():
			continue
		var r: float = h.lantern.radius() / World.TILE - LIGHT_EDGE
		if r > 0.0 and (Vector2(c) - Vector2(h.player.cell)).length() <= r:
			return true
	if Hero.all.is_empty():
		var r0 := lantern.radius() / World.TILE - LIGHT_EDGE
		if r0 > 0.0 and (Vector2(c) - Vector2(player.cell)).length() <= r0:
			return true
	if world._in_bounds(c) and _static_lit[c.y * world.width + c.x] == 1:
		return true
	for f in flares.planted:
		if (Vector2(c) - Vector2(f)).length() <= FLARE_LIGHT_RADIUS:
			return true
	return false


func _free(c: Vector2i) -> bool:
	for h in Hero.all:
		if h.alive() and h.player.cell == c:
			return false
	return world.is_walkable(c) and c != player.cell and enemy_at(c) == null and not world.in_village(c)


## Removes a slain enemy.
func remove(e: Enemy) -> void:
	list.erase(e)
	_think.erase(e)
	e.queue_free()


## After you run from a fight: it reels for a few seconds.
func shake_off(e: Enemy) -> void:
	e.stunned = 3.0
	_think[e] = 3.0
	var away := e.cell + _away_dir(e)
	if _free(away):
		e.step_to(away, 0.2)


# --- Brains ------------------------------------------------------------------

func _process(delta: float) -> void:
	var heroes: Array = Hero.all.filter(func(h): return h.alive())
	if heroes.is_empty():
		return
	# Each player in the dark gets their own ghost.
	for h in heroes:
		bind(h)
		if in_the_dark() and h.player.ui_lock == "":
			_summon_ghost()
		elif _gathering() and h.player.ui_lock == "":
			_summon_ghost()   # the flame is low: one starts circling at the edge of your light
		elif not in_the_dark():
			if _hunter != null and list.has(_hunter) and _phase.get(_hunter, "") in ["lurk", "hidden"]:
				_phase.erase(_hunter)   # the flame's back up: it melts away
				_puff(_hunter.position + Vector2(8, 6), Color(0.75, 0.8, 1.0, 0.6), Color(0.4, 0.4, 0.7, 0.0), 14, _hunter.get_parent())
				_relocate_ghost(_hunter)
			_hunter = null
	if cur != null:
		_hunters[cur] = _hunter
	var daytime := is_daytime()
	for e in list:
		if e.in_battle:
			continue   # someone's fighting it right now
		if daytime and e.kind != "insect":
			e.visible = false   # demons and ghosts shun the sun
			continue
		# think about the nearest player (or the one this ghost is hunting)
		var tgt: Hero = _target_for(e, heroes)
		bind(tgt)
		var dark := in_the_dark()
		var menus_open := tgt.player.ui_lock != ""
		var far := 9999
		for h in heroes:
			far = mini(far, maxi(absi(e.cell.x - h.player.cell.x), absi(e.cell.y - h.player.cell.y)))
		var hunting := e == _hunter and dark
		e.visible = far <= ACTIVE_RANGE + 4 or hunting
		if e.kind == "ghost":
			e.hunting = hunting
			var hidden: bool = hunting and _phase.get(e, "") == "hidden"
			var lurking: bool = e == _hunter and _phase.get(e, "") == "lurk" and not dark
			e.fade = move_toward(e.fade, 0.0 if hidden else (0.55 if lurking else 1.0), delta / GHOST_APPEAR)
			if lurking:
				e.visible = true
			e.windup = hunting and _phase.get(e, "") == "windup"
		if far > ACTIVE_RANGE and not hunting:
			continue   # asleep, far away
		e.calm = maxf(e.calm - delta, 0.0)
		if e.chasing:
			e.chase_t += delta
		e.lit = is_lit(e.cell)
		if e.moving or menus_open:
			continue
		if e.kind != "ghost" and lantern.blue_left > 0.0 and _dist(e) <= lantern.radius() / World.TILE + 1.5:
			_flee(e)   # the blue flame: they can't stand it
			continue
		_think[e] -= delta
		if _think[e] > 0.0:
			continue
		_think[e] = 0.0
		match e.kind:
			"insect": _insect(e)
			"demon": _demon(e)
			"ghost": _ghost(e)


## Who a creature cares about: the player it's hunting (ghosts), else the
## nearest player who isn't busy fighting something else.
func _target_for(e: Enemy, heroes: Array) -> Hero:
	if e.kind == "ghost":
		for h in heroes:
			if _hunters.get(h) == e:
				return h
	var best: Hero = heroes[0]
	var best_d := INF
	for h in heroes:
		var d := (Vector2(e.cell) - Vector2(h.player.cell)).length()
		if h.player.ui_lock == "battle":
			d += 1000.0
		if d < best_d:
			best = h
			best_d = d
	return best


func _dist(e: Enemy) -> float:
	return (Vector2(e.cell) - Vector2(player.cell)).length()


func _insect(e: Enemy) -> void:
	var aggro: float = e.info.aggro
	if e.info.get("moth", false) and lantern.state == Lantern.State.LIT:
		aggro += lantern.radius() / World.TILE   # drawn to the flame
	if not e.hunter:
		aggro = SHY_REACH   # only if you walk right up to it
	if _hunt(e, aggro):
		return
	if not e.hunter and _dist(e) <= SHY_AVOID and _rng.randf() < 0.6:
		_keep_away(e)
	else:
		_wander(e, false)


func _demon(e: Enemy) -> void:
	if not _hunt(e, e.info.aggro):
		_wander(e, false)


## Chases if it has noticed you (and hasn't given up). Returns true if it did.
func _hunt(e: Enemy, aggro: float) -> bool:
	var d := _dist(e)
	if e.stunned > 0.0 or e.calm > 0.0:
		return false
	if not e.chasing:
		if d > aggro:
			return false
		e.chasing = true
		e.chase_t = 0.0
	# outrun it, or keep it busy long enough, and it loses interest
	if d > aggro + GIVE_UP_GAP or e.chase_t > CHASE_PATIENCE[e.kind]:
		e.chasing = false
		e.calm = _rng.randf_range(CALM_TIME[0], CALM_TIME[1])
		return false
	_chase(e, false)
	return true


## A shy creature edges away from you, unhurried.
func _keep_away(e: Enemy) -> void:
	var best := e.cell
	var best_d := _dist(e)
	for d in DIRS:
		var c := e.cell + d
		var dd := (Vector2(c) - Vector2(player.cell)).length()
		if dd > best_d and _free(c):
			best = c
			best_d = dd
	if best != e.cell:
		e.step_to(best, e.info.step * 1.5)
	_think[e] = _rng.randf_range(0.2, 0.6)


## True when your lantern is out and no candle, mushroom or flare lights you.
func in_the_dark() -> bool:
	if is_daytime() or lantern.state == Lantern.State.LIT or world.in_village(player.cell):
		return false
	if world._in_bounds(player.cell) and _static_lit[player.cell.y * world.width + player.cell.x] == 1:
		return false
	for f in flares.planted:
		if (Vector2(player.cell) - Vector2(f)).length() <= FLARE_LIGHT_RADIUS:
			return false
	return true


## Your flame is in its last quarter (at night, out in the labyrinth).
func _gathering() -> bool:
	return not is_daytime() and lantern.ghosts_gather() and not world.in_village(player.cell)


## Makes sure one ghost (only one at a time) is hunting you.
func _summon_ghost() -> void:
	if is_instance_valid(_hunter) and list.has(_hunter):
		if _dist(_hunter) > GHOST_HUNT_RANGE:
			_relocate_ghost(_hunter)
		return
	var taken := _hunters.values()
	var ghosts := list.filter(func(e): return e.kind == "ghost" and not taken.has(e))
	if ghosts.is_empty():
		return
	_hunter = ghosts[_rng.randi() % ghosts.size()]
	_hunter.fade = 0.0
	_phase[_hunter] = "hidden"
	_think[_hunter] = _rng.randf_range(0.4, 0.9)


## Puts the hunting ghost somewhere near the edge of your screen, so you see
## it take shape and come for you.
func _place_on_screen(g: Enemy) -> void:
	for attempt in 12:
		var ang := _rng.randf() * TAU
		var off := Vector2(cos(ang) * _rng.randf_range(8.5, 10.0), sin(ang) * _rng.randf_range(5.5, 6.5))
		var c := player.cell + Vector2i(off.round())
		if _in_map(c) and (Vector2(c) - Vector2(player.cell)).length() >= 5.0:
			g.cell = c
			g.position = Vector2(c * World.TILE)
			g.moving = false
			return
	_relocate_ghost(g)


func _relocate_ghost(g: Enemy) -> void:
	var ang := _rng.randf() * TAU
	var dist := _rng.randf_range(GHOST_RETURN[0], GHOST_RETURN[1])
	var c := player.cell + Vector2i(Vector2.from_angle(ang) * dist)
	c.x = clampi(c.x, 1, world.width - 2)
	c.y = clampi(c.y, 1, world.height - 2)
	g.cell = c
	g.position = Vector2(c * World.TILE)
	g.moving = false


func _ghost(e: Enemy) -> void:
	var d := _dist(e)
	if in_the_dark() and e == _hunter:
		# Your light is out. It takes shape at the edge of sight, then comes
		# for you -- fast, straight through the walls -- rears up, and strikes.
		match _phase.get(e, "rush"):
			"hidden":
				_place_on_screen(e)
				e.fade = 0.0
				_puff(e.position + Vector2(8, 6), Color(0.75, 0.8, 1.0, 0.7), Color(0.4, 0.4, 0.7, 0.0), 18, e.get_parent())
				Sfx.play("ghost_appear")
				_phase[e] = "appear"
				_think[e] = GHOST_APPEAR
				return
			"windup":
				if d <= 1.5:
					_ghost_strike(e)
					return
				_phase[e] = "rush"
		_phase[e] = "rush"
		if d <= 1.5:
			_phase[e] = "windup"
			_think[e] = GHOST_WINDUP
			return
		var dir := Vector2(player.cell - e.cell)
		var step := Vector2i(signi(int(roundf(dir.x))), signi(int(roundf(dir.y))))
		if absf(dir.x) > absf(dir.y) * 2.0:
			step.y = 0
		elif absf(dir.y) > absf(dir.x) * 2.0:
			step.x = 0
		e.step_to(e.cell + step, GHOST_RUSH_STEP * (1.4 if step.x != 0 and step.y != 0 else 1.0))
		return
	if e == _hunter and _gathering():
		_lurk(e, d)
		return
	_phase.erase(e)
	if e.lit or d < GHOST_KEEP_AWAY:
		var away := e.cell + _away_dir(e)
		if _in_map(away):
			e.step_to(away, e.info.step * 0.7)
		_think[e] = 0.1
		return
	# Drift aimlessly, through walls, now and then.
	if _rng.randf() < 0.5:
		var c := e.cell + DIRS[_rng.randi() % 4]
		if _in_map(c) and (Vector2(c) - Vector2(player.cell)).length() >= GHOST_KEEP_AWAY:
			e.step_to(c, e.info.step)
	_think[e] = _rng.randf_range(0.3, 1.2)


## While your flame is low, the hunting ghost shows itself and circles just
## outside your light, waiting. It doesn't strike -- not until the flame dies.
func _lurk(e: Enemy, d: float) -> void:
	if _phase.get(e, "hidden") == "hidden":
		_place_on_screen(e)
		e.fade = 0.0
		_puff(e.position + Vector2(8, 6), Color(0.75, 0.8, 1.0, 0.5), Color(0.4, 0.4, 0.7, 0.0), 12, e.get_parent())
		Sfx.play("ghost_appear", -8.0)
		_phase[e] = "lurk"
		_think[e] = GHOST_APPEAR
		return
	_phase[e] = "lurk"
	var ring := lantern.radius() / World.TILE + 2.5
	# drift around you, keeping just out of the light
	var rel := Vector2(e.cell - player.cell)
	if rel == Vector2.ZERO:
		rel = Vector2.RIGHT
	var ang := rel.angle() + (0.45 if (e.get_instance_id() % 2) == 0 else -0.45)
	var want := player.cell + Vector2i((Vector2.from_angle(ang) * ring).round())
	var step := Vector2i(signi(want.x - e.cell.x), signi(want.y - e.cell.y))
	if step != Vector2i.ZERO and _in_map(e.cell + step):
		e.step_to(e.cell + step, e.info.step * 1.6)
	_think[e] = _rng.randf_range(0.2, 0.5)


## A bomb scattered this ghost: it breaks apart and has to re-form.
func scatter_ghost(e: Enemy) -> void:
	Sfx.play_at("ghost_scatter", e.position)
	_puff(e.position + Vector2(8, 6), Color(0.85, 0.85, 1.0, 0.8), Color(0.5, 0.5, 0.7, 0.0), 24, e.get_parent())
	e.fade = 0.0
	if e == _hunter:
		_phase[e] = "hidden"
	_relocate_ghost(e)
	_think[e] = _rng.randf_range(GHOST_REST[0] + 2.0, GHOST_REST[1] + 3.0)


## Runs from the blue flame, as fast as it can.
func _flee(e: Enemy) -> void:
	var best := e.cell
	var best_d := _dist(e)
	for d in DIRS:
		var c: Vector2i = e.cell + d
		var dd := (Vector2(c) - Vector2(player.cell)).length()
		if dd > best_d and _free(c):
			best = c
			best_d = dd
	if best != e.cell:
		e.step_to(best, e.info.step * 0.7)
	_think[e] = 0.05


func _in_map(c: Vector2i) -> bool:
	return c.x > 0 and c.y > 0 and c.x < world.width - 1 and c.y < world.height - 1


func _away_dir(e: Enemy) -> Vector2i:
	var dir := Vector2(e.cell - player.cell)
	if dir == Vector2.ZERO:
		return DIRS[_rng.randi() % 4]
	if absf(dir.x) >= absf(dir.y):
		return Vector2i(signi(int(dir.x)), 0)
	return Vector2i(0, signi(int(dir.y)))


## Walk toward the player along the shortest path. Demons won't step into light.
func _chase(e: Enemy, avoid_light: bool) -> void:
	# now and then you hear it coming
	if not e.has_meta("heard") or Time.get_ticks_msec() - int(e.get_meta("heard")) > 6000:
		if _rng.randf() < 0.08:
			e.set_meta("heard", Time.get_ticks_msec())
			Sfx.play_at("demon" if e.kind == "demon" else "insect", e.position, -2.0)
	if _dist(e) <= 1.01:
		_attack(e)
		return
	var next := _next_step_toward(e.cell, player.cell, 16)
	if next == e.cell or not _free(next):
		_think[e] = 0.2
		return
	if avoid_light and is_lit(next):
		_think[e] = 0.25   # lurk at the edge of the light, watching
		e.facing_left = player.cell.x < e.cell.x
		return
	e.step_to(next, e.info.step)


## A slain creature dissolves into thick purple smoke.
func dissolve(e: Enemy) -> void:
	_puff(e.position + Vector2(8, 4), Color(0.55, 0.25, 0.75, 0.95), Color(0.2, 0.05, 0.3, 0.0), 40)
	remove(e)


func _puff(at: Vector2, c0: Color = Color(0.25, 0.1, 0.15, 0.9), c1: Color = Color(0.1, 0.05, 0.1, 0.0),
		amount: int = 24, parent: Node = null) -> void:
	var smoke := CPUParticles2D.new()
	smoke.position = at
	smoke.one_shot = true
	smoke.emitting = true
	smoke.amount = amount
	smoke.lifetime = 0.9
	smoke.explosiveness = 0.9
	smoke.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	smoke.emission_rect_extents = Vector2(5, 8)
	smoke.direction = Vector2(0, -1)
	smoke.spread = 70.0
	smoke.gravity = Vector2(0, -12)
	smoke.initial_velocity_min = 6.0
	smoke.initial_velocity_max = 18.0
	smoke.scale_amount_min = 1.0
	smoke.scale_amount_max = 3.0
	var ramp := Gradient.new()
	ramp.set_color(0, c0)
	ramp.set_color(1, c1)
	smoke.color_ramp = ramp
	(parent if parent != null else _fx_parent).add_child(smoke)
	smoke.finished.connect(smoke.queue_free)


func _wander(e: Enemy, avoid_light: bool) -> void:
	if _rng.randf() < 0.35:
		_think[e] = _rng.randf_range(0.4, 1.5)   # pause, listen
		return
	var options: Array[Vector2i] = []
	for d in DIRS:
		var c := e.cell + d
		if _free(c) and not (avoid_light and is_lit(c)):
			options.append(c)
	if options.is_empty():
		_think[e] = 0.5
		return
	e.step_to(options[_rng.randi() % options.size()], e.info.step * 1.4)
	_think[e] = _rng.randf_range(0.0, 0.4)


func _attack(e: Enemy) -> void:
	if e.kind != "ghost" and lantern.blue_left > 0.0:
		_flee(e)
		return
	if e.stunned > 0.0 or player.moving:
		_think[e] = 0.15
		return
	if e.kind != "ghost":
		# It has to actually reach you: a quick lunge into your tile, then the fight.
		player.ui_lock = "encounter"
		Sfx.play("demon" if e.kind == "demon" else "insect")
		e.set_meta("hero", cur)
		e.lunge(player.position, func() -> void: encounter.emit(e))
		_think[e] = 1.0
		return
	_ghost_strike(e)


## A ghost strikes, then vanishes into the dark to come again later.
func _ghost_strike(e: Enemy) -> void:
	Sfx.play("ghost_strike")
	e.set_meta("hero", cur)
	hit_player.emit(e, GHOST_DAMAGE)
	_puff(e.position + Vector2(8, 6), Color(0.85, 0.85, 1.0, 0.8), Color(0.5, 0.5, 0.7, 0.0), 24, e.get_parent())
	e.fade = 0.0
	_phase[e] = "hidden"
	_think[e] = _rng.randf_range(GHOST_REST[0], GHOST_REST[1])


## First step of a shortest path from `from` toward `to` (BFS, limited depth).
func _next_step_toward(from: Vector2i, to: Vector2i, max_depth: int) -> Vector2i:
	var prev := {from: from}
	var depth := {from: 0}
	var queue: Array[Vector2i] = [from]
	var head := 0
	var found := false
	while head < queue.size():
		var c: Vector2i = queue[head]
		head += 1
		if c == to:
			found = true
			break
		if depth[c] >= max_depth:
			continue
		for d in DIRS:
			var n := c + d
			if prev.has(n):
				continue
			if n == to or world.is_walkable(n):
				prev[n] = c
				depth[n] = depth[c] + 1
				queue.append(n)
	if not found:
		return from
	var c := to
	while prev[c] != from:
		c = prev[c]
	return c
