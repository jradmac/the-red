## Every creature: [kind ("insect" / "demon"), index, name, tier], insects first.
static func creatures() -> Array:
	var out := []
	for kind in ["insect", "demon"]:
		var list: Array = CreatureData.TYPES[kind]
		for i in list.size():
			out.append([kind, i, String(list[i].name), String(list[i].get("tier", "COMMON"))])
	return out


## Every weapon id, in the order of the journal's grid (weakest first).
static func weapons() -> Array:
	return ["rusty_dagger", "bone_club", "pitchfork", "cleaver", "hatchet", "hooked_sickle", "boar_spear",
		"iron_mace", "flail", "grave_blade", "silver_dagger", "war_scythe", "wardens_axe"]
